{
    "name": "veltrom/wp-license-sdk",
    "description": "Veltrom licensing SDK for WordPress plugins: activation, offline-verified entitlements and updates.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "homepage": "https://veltrom.com",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Veltrom\\License\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Veltrom\\License\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint --test",
        "fix": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
